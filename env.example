# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Admin (siz)ning Telegram chat ID'ingiz
# Bilish uchun @userinfobot ga /start yozing
ADMIN_CHAT_ID=

# Google Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ixtiyoriy: Gemini model nomi (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Ixtiyoriy: SQLite baza fayli manzili.
# Railway'da Volume ulasangiz, uni /data ga mount qiling va shu yerga
# DB_PATH=/data/bot.db deb yozing — aks holda baza qayta deploy vaqtida o'chadi.
DB_PATH=bot.db
